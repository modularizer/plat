# PLAT Authority Server — Environment Configuration
# Copy this to .env and customize for your environment.
# All values shown are defaults; uncomment to override.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
AUTHORITY_URL=http://localhost:3000
# HOST=0.0.0.0
# ADMIN_TOKEN=dev-token-change-in-production
# TRACEBACK_MAX_LINES=0

# Path where the authority's identity keypair is persisted.
# AUTHORITY_IDENTITY_KEYPAIR_FILE=.authority-identity.json

# ─── Frontend origins (added to WS origin allowlist) ─────────────────────────
# STUDIO_ORIGIN=http://localhost:5173
# SITEVIEWER_ORIGIN=http://localhost:5174

# ─── Namespace routing ───────────────────────────────────────────────────────
# Treat hosts ending in this base domain as subdomain-style names.
# Example: whiteboard.alice.plat.local => namespace "alice", subpath "whiteboard"
# AUTHORITY_SUBDOMAIN_BASE_DOMAIN=plat.local

# Allow origin-scoped namespace ownership across multiple marketplace fronts.
# Examples (both resolve to ownership key "apple.pear.com::donkey"):
#   apple.pear.com/donkey
#   notes.donkey.apple.pear.com
# AUTHORITY_ALLOWED_ORIGINS=apple.pear.com,browservable.com,coolsite.ai

# Comma-separated namespace globs that can never be claimed (supports *).
# AUTHORITY_DISALLOWED_NAMESPACE_GLOBS=admin-*,*-internal,staging

# ─── Free namespace assignment ───────────────────────────────────────────────
# FREE_NAMESPACE_MAX_PER_USER=1
# FREE_NAMESPACE_AUTO_ASSIGN=true

# ─── Host authentication ─────────────────────────────────────────────────────
# insecure_token_sub: token value is treated as host google_sub (dev only)
# google_tokeninfo:   validates Google ID token via tokeninfo endpoint
HOST_AUTH_MODE=insecure_token_sub

# Shared Google client ID — used for host token verification and /authSession.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional extra audiences (comma-separated) accepted by /authSession.
# Useful when a CLI or service-account flow mints ID tokens with a different aud.
# GOOGLE_ID_TOKEN_AUDIENCES=cli-client-id,service-account-target-audience

# Optional Workspace hosted-domain allowlist for /authSession.
# GOOGLE_ALLOWED_HOSTED_DOMAINS=example.com

# ─── Admin sessions ──────────────────────────────────────────────────────────
# ADMIN_GOOGLE_SUBS=google-sub-1,google-sub-2
# ADMIN_SESSION_TTL_SECONDS=43200
# ADMIN_SESSION_SECRET=replace-me-with-a-long-random-secret

# ─── Rate limiting ───────────────────────────────────────────────────────────
# CONNECT_RATE_LIMIT_PER_30S=500
# WS_HOST_MSG_RATE_LIMIT_PER_30S=300
# WS_PRESENCE_MSG_RATE_LIMIT_PER_30S=300
# OAUTH_RATE_LIMIT_PER_30S=30

# ─── Storage ─────────────────────────────────────────────────────────────────
# Options: memory, json, yaml, drizzle
# STORAGE_TYPE=drizzle
# STORAGE_PATH=/app/data/servers.json   # required for json/yaml

# ─── PostgreSQL (used when STORAGE_TYPE=drizzle) ─────────────────────────────
POSTGRES_USER=plat
POSTGRES_PASSWORD=plat_development_password
POSTGRES_DB=plat_authority
# POSTGRES_PORT=5432

# Auto-derived from POSTGRES_* in docker-compose; set explicitly for non-docker runs.
# DATABASE_URL=postgresql://plat:plat_development_password@localhost:5432/plat_authority

# ─── Redis ───────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379

# ─── Admin dashboard (docker compose) ────────────────────────────────────────
ADMIN_PORT=3001